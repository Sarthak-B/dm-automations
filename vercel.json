{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/bridge.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:route",
      "destination": "/api/bridge?route=:route"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "framework": null,
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
